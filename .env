# Get this from @BotFather on Telegram after creating your bot
TELEGRAM_BOT_TOKEN=

# Leave empty for the first deploy. Message the bot /start, it will reply
# with your chat ID — then set it here and redeploy to lock the bot to you.
OWNER_CHAT_ID=

# Optional tuning (defaults shown)
POLL_INTERVAL_SECONDS=60
STALE_AFTER_HOURS=48
